{
  "expo": {
    "name": "Beachly",
    "slug": "beachly-mobile",
    "owner": "israelsondias",
    "scheme": "beachly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0ea5e9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beachly.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Beachly precisa da sua localização para mostrar praias próximas",
        "NSLocationAlwaysUsageDescription": "Beachly precisa da sua localização para enviar notificações sobre praias favoritas"
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDavvE9VitYMiWJj5rN7x_KTzRQuTjuOlc"
      }
    },
    "android": {
      "package": "com.beachly.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDavvE9VitYMiWJj5rN7x_KTzRQuTjuOlc"
        }
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0ea5e9",
          "androidMode": "default",
          "androidCollapsedTitle": "Beachly"
        }
      ]
    ],
    "extra": {
      "API_BASE_URL": "http://76.13.232.232:8000",
      "eas": {
        "projectId": "9105dae8-c758-4b52-8250-cf5d0e0e3712"
      }
    }
  }
}
